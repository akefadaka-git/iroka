{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IGACMS Historical Migration Evidence v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_commit",
    "source_blob_sha",
    "digest",
    "disposition"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "source_blob_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "disposition": {
      "enum": [
        "RETAIN-HISTORICAL",
        "EXTENSION-REVIEW"
      ]
    }
  }
}
