{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.local/igacms/1.0.0/genome.schema.json",
  "title": "IROKA ZERO IGACMS Genome v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "specification_id",
    "specification_version",
    "dna",
    "genome",
    "historical_domains",
    "chromosomes",
    "genes",
    "principles",
    "invariants",
    "markers",
    "mutation_policy",
    "compatibility_manifest",
    "historical_disposition_references",
    "dependency_graph"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "specification_id": {
      "const": "IGACMS"
    },
    "specification_version": {
      "const": "1.0.0"
    },
    "dna": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "contract_version",
        "motto"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "iroka.dna"
        },
        "kind": {
          "const": "IROKA_CONSTITUTIONAL_DNA_CONTRACT"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "motto": {
          "type": "string"
        }
      }
    },
    "genome": {
      "type": "object",
      "required": [
        "id",
        "version",
        "compatibility_family",
        "epoch"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "IROKA_ZERO_GENOME"
        },
        "version": {
          "type": "string"
        },
        "compatibility_family": {
          "type": "string"
        },
        "epoch": {
          "const": 0
        }
      }
    },
    "historical_domains": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity",
          "authority",
          "evidence",
          "assurance",
          "reasoning",
          "security",
          "execution",
          "evolution"
        ]
      }
    },
    "chromosomes": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "chromosome.schema.json"
      }
    },
    "genes": {
      "type": "array",
      "minItems": 36,
      "items": {
        "$ref": "gene.schema.json"
      }
    },
    "principles": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "statement"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "enforcement",
          "violation",
          "statement"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high"
            ]
          },
          "enforcement": {
            "type": "string"
          },
          "violation": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          }
        }
      }
    },
    "markers": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "$ref": "marker-definition.schema.json"
      }
    },
    "mutation_policy": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "compatibility_manifest": {
      "type": "object"
    },
    "historical_disposition_references": {
      "type": "array",
      "minItems": 2
    },
    "dependency_graph": {
      "type": "array",
      "minItems": 12
    },
    "created_by": {
      "type": "string"
    }
  }
}
