{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g01.lineage/output/1.1.0",
  "title": "g01.lineage output contract v1.1.0",
  "description": "Lineage output is valid only when proof, parent resolution, graph integrity and epoch ordering are all verified.",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "lineage_valid": {
      "type": "boolean"
    },
    "chain_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "verified_depth": {
      "type": "integer",
      "minimum": 0
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "subject_id",
    "lineage_valid",
    "chain_digest",
    "verified_depth",
    "evidence",
    "version_bound_evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lineage_valid": {
            "const": true
          }
        },
        "required": [
          "lineage_valid"
        ]
      },
      "then": {
        "properties": {
          "verified_depth": {
            "minimum": 2
          },
          "evidence": {
            "$ref": "#/$defs/positive_evidence"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage_valid": {
            "const": false
          }
        },
        "required": [
          "lineage_valid"
        ]
      },
      "then": {
        "properties": {
          "verified_depth": {
            "const": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "proof_verification": {
      "type": "object",
      "properties": {
        "verified": {
          "const": true
        },
        "proof_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "issuer_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "verified",
        "proof_digest",
        "issuer_id",
        "policy_id",
        "policy_version"
      ],
      "additionalProperties": false
    },
    "graph_integrity": {
      "type": "object",
      "properties": {
        "cycle_free": {
          "const": true
        },
        "conflict_free": {
          "const": true
        },
        "complete": {
          "const": true
        }
      },
      "required": [
        "cycle_free",
        "conflict_free",
        "complete"
      ],
      "additionalProperties": false
    },
    "parent_resolution": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "predecessor_id": {
          "type": "string",
          "minLength": 1
        },
        "resolved": {
          "const": true
        }
      },
      "required": [
        "subject_id",
        "predecessor_id",
        "resolved"
      ],
      "additionalProperties": false
    },
    "epoch_validation": {
      "type": "object",
      "properties": {
        "predecessor_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "subject_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "monotonic": {
          "const": true
        }
      },
      "required": [
        "predecessor_epoch",
        "subject_epoch",
        "monotonic"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        },
        "proof_verification": {
          "$ref": "#/$defs/proof_verification"
        },
        "graph_integrity": {
          "$ref": "#/$defs/graph_integrity"
        },
        "parent_resolution": {
          "$ref": "#/$defs/parent_resolution"
        },
        "epoch_validation": {
          "$ref": "#/$defs/epoch_validation"
        },
        "decision_rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence",
        "proof_verification",
        "graph_integrity",
        "parent_resolution",
        "epoch_validation",
        "decision_rationale"
      ],
      "additionalProperties": false
    },
    "positive_evidence": {
      "allOf": [
        {
          "$ref": "#/$defs/evidence"
        }
      ],
      "properties": {
        "proof_verification": {
          "$ref": "#/$defs/proof_verification"
        },
        "graph_integrity": {
          "$ref": "#/$defs/graph_integrity"
        },
        "parent_resolution": {
          "$ref": "#/$defs/parent_resolution"
        },
        "epoch_validation": {
          "$ref": "#/$defs/epoch_validation"
        }
      }
    }
  }
}
