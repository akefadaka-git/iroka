{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://iroka.dev/schemas/genes/g02.authority-source/output/1.1.0",
  "title":"G02 authority-source A3 output v1.1.0",
  "type":"object",
  "additionalProperties":false,
  "properties":{
    "authority_id":{"type":"string","minLength":1},
    "source_valid":{"type":"boolean"},
    "scope":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "decision":{"enum":["valid","invalid","expired"]},
    "evidence":{
      "type":"object","additionalProperties":false,
      "properties":{
        "principal_registration_verified":{"type":"boolean"},
        "source_class_verified":{"type":"boolean"},
        "mandate_signature_verified":{"type":"boolean"},
        "mandate_scope_verified":{"type":"boolean"},
        "temporal_validity_verified":{"type":"boolean"},
        "revocation_checked":{"type":"boolean"},
        "delegation_chain_verified":{"type":"boolean"},
        "evaluated_at":{"type":"string","pattern":"^unix:[0-9]+$"},
        "provenance":{"type":"object","minProperties":1},
        "decision_reason":{"type":"string","minLength":1}
      },
      "required":["principal_registration_verified","source_class_verified","mandate_signature_verified","mandate_scope_verified","temporal_validity_verified","revocation_checked","delegation_chain_verified","evaluated_at","provenance","decision_reason"]
    },
    "version_bound_evidence":{"type":"object","minProperties":1}
  },
  "required":["authority_id","source_valid","scope","decision","evidence","version_bound_evidence"],
  "allOf":[
    {
      "if":{"properties":{"source_valid":{"const":true}},"required":["source_valid"]},
      "then":{"properties":{
        "decision":{"const":"valid"},
        "scope":{"minItems":1},
        "evidence":{"properties":{
          "principal_registration_verified":{"const":true},
          "source_class_verified":{"const":true},
          "mandate_signature_verified":{"const":true},
          "mandate_scope_verified":{"const":true},
          "temporal_validity_verified":{"const":true},
          "revocation_checked":{"const":true},
          "delegation_chain_verified":{"const":true}
        }}
      }}
    },
    {
      "if":{"properties":{"source_valid":{"const":false}},"required":["source_valid"]},
      "then":{"properties":{"decision":{"enum":["invalid","expired"]},"scope":{"maxItems":0}}}
    }
  ]
}
