{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/a3/g08.workflow-graph/input/1.0.0",
  "title": "G08 workflow graph A3 input",
  "type": "object",
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenance": {
      "type": "object",
      "properties": {
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 512},
        "revision_ref": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "required": ["source_ref", "revision_ref"],
      "additionalProperties": false
    },
    "version_bound_evidence": {
      "type": "object",
      "properties": {
        "workflow_registry_digest": {"$ref": "#/$defs/digest"},
        "operation_registry_digest": {"$ref": "#/$defs/digest"},
        "dependency_registry_digest": {"$ref": "#/$defs/digest"},
        "graph_revision_digest": {"$ref": "#/$defs/digest"},
        "configuration_digest_algorithm": {"const": "SHA-256"},
        "graph_validator_version": {"const": "1.0.0"}
      },
      "required": ["workflow_registry_digest", "operation_registry_digest", "dependency_registry_digest", "graph_revision_digest", "configuration_digest_algorithm", "graph_validator_version"],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "node_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "node_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "operation_ref": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "configuration_digest": {"$ref": "#/$defs/digest"}
      },
      "required": ["node_id", "node_type", "operation_ref", "configuration_digest"],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "edge_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "from_node_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "to_node_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
        "dependency_type": {"enum": ["required", "ordering"]}
      },
      "required": ["edge_id", "from_node_id", "to_node_id", "dependency_type"],
      "additionalProperties": false
    }
  },
  "properties": {
    "workflow_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/node"}, "uniqueItems": true},
    "edges": {"type": "array", "maxItems": 50000, "items": {"$ref": "#/$defs/edge"}, "uniqueItems": true},
    "graph_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "version_bound_evidence": {"$ref": "#/$defs/version_bound_evidence"}
  },
  "required": ["workflow_id", "nodes", "edges", "graph_version", "provenance", "version_bound_evidence"],
  "additionalProperties": false
}
