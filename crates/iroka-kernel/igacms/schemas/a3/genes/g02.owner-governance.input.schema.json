{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://iroka.dev/schemas/genes/g02.owner-governance/input/1.1.0",
  "title":"G02 Owner-governance A3 input v1.1.0",
  "type":"object","additionalProperties":false,
  "$defs":{
    "timestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "entry":{
      "type":"object","additionalProperties":false,
      "properties":{
        "decision_id":{"type":"string","minLength":1},
        "owner_id":{"type":"string","minLength":1},
        "decision_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "scope":{"$ref":"#/$defs/scope"},
        "nonce":{"type":"string","minLength":16},
        "sequence":{"type":"integer","minimum":1},
        "status":{"enum":["active","superseded","revoked"]},
        "superseded_by":{"oneOf":[{"type":"null"},{"type":"string","minLength":1}]}
      },
      "required":["decision_id","owner_id","decision_digest","scope","nonce","sequence","status","superseded_by"]
    },
    "approval":{
      "type":"object","additionalProperties":false,
      "properties":{
        "payload":{
          "type":"object","additionalProperties":false,
          "properties":{
            "owner_id":{"type":"string","minLength":1},
            "decision_id":{"type":"string","minLength":1},
            "decision":{"enum":["approved","rejected"]},
            "decision_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
            "scope":{"$ref":"#/$defs/scope"},
            "nonce":{"type":"string","minLength":16},
            "contract_version":{"type":"string","minLength":1},
            "issued_at":{"$ref":"#/$defs/timestamp"},
            "expires_at":{"$ref":"#/$defs/timestamp"}
          },
          "required":["owner_id","decision_id","decision","decision_digest","scope","nonce","contract_version","issued_at","expires_at"]
        },
        "signature":{"type":"array","minItems":64,"maxItems":64,"items":{"type":"integer","minimum":0,"maximum":255}}
      },
      "required":["payload","signature"]
    },
    "register_snapshot":{
      "type":"object","additionalProperties":false,
      "properties":{
        "owner_id":{"type":"string","minLength":1},
        "key_id":{"type":"string","minLength":1},
        "issued_at":{"$ref":"#/$defs/timestamp"},
        "expires_at":{"$ref":"#/$defs/timestamp"},
        "sequence":{"type":"integer","minimum":1},
        "entries":{"type":"array","minItems":1,"maxItems":4096,"items":{"$ref":"#/$defs/entry"}},
        "signature":{"type":"array","minItems":64,"maxItems":64,"items":{"type":"integer","minimum":0,"maximum":255}}
      },
      "required":["owner_id","key_id","issued_at","expires_at","sequence","entries","signature"]
    }
  },
  "properties":{
    "owner_id":{"type":"string","minLength":1},
    "decision_id":{"type":"string","minLength":1},
    "scope":{"$ref":"#/$defs/scope"},
    "approval_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "signature":{"type":"array","minItems":64,"maxItems":64,"items":{"type":"integer","minimum":0,"maximum":255}},
    "issued_at":{"$ref":"#/$defs/timestamp"},
    "expires_at":{"$ref":"#/$defs/timestamp"},
    "approval":{"$ref":"#/$defs/approval"},
    "register_snapshot":{"$ref":"#/$defs/register_snapshot"},
    "provenance":{"type":"object","minProperties":1},
    "version_bound_evidence":{"type":"object","minProperties":1},
    "safeguard_conflicts":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
  },
  "required":["owner_id","decision_id","scope","approval_digest","signature","issued_at","expires_at","approval","register_snapshot","provenance","version_bound_evidence","safeguard_conflicts"]
}
