{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://iroka.dev/schemas/genes/g03.inference-rules/output/1.1.0",
  "title":"G03 inference-rules A3 output v1.1.0",
  "type":"object","additionalProperties":false,
  "$defs":{
    "trace":{
      "type":"object","additionalProperties":false,
      "properties":{
        "step_id":{"type":"string","minLength":1},
        "rule_id":{"type":"string","minLength":1},
        "rule_version":{"type":"string","minLength":1},
        "premise_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "rule_expression":{"type":"string","pattern":"^(AXIOM|AND\\([A-Za-z0-9._:-]+(,[A-Za-z0-9._:-]+)*\\))$"},
        "intermediate_support":{"type":"number","minimum":0,"maximum":1}
      },
      "required":["step_id","rule_id","rule_version","premise_ids","rule_expression","intermediate_support"]
    },
    "conclusion":{
      "type":"object","additionalProperties":false,
      "properties":{
        "conclusion_id":{"type":"string","minLength":1},
        "statement":{"type":"string","minLength":1},
        "supporting_premise_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "applied_rule_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "confidence":{"type":"number","minimum":0,"maximum":1},
        "derivation_trace":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/trace"}}
      },
      "required":["conclusion_id","statement","supporting_premise_ids","applied_rule_ids","confidence","derivation_trace"]
    },
    "unsupported":{
      "type":"object","additionalProperties":false,
      "properties":{
        "step_id":{"type":"string","minLength":1},
        "rule_id":{"oneOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "premise_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "reason":{"type":"string","minLength":1}
      },
      "required":["step_id","rule_id","premise_ids","reason"]
    }
  },
  "properties":{
    "inference_id":{"type":"string","minLength":1},
    "conclusion_set":{"type":"array","items":{"$ref":"#/$defs/conclusion"}},
    "applied_rule_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "unsupported_steps":{"type":"array","items":{"$ref":"#/$defs/unsupported"}},
    "evidence":{
      "type":"object","additionalProperties":false,
      "properties":{
        "query_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "premise_set_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "premise_model_version":{"type":"string","minLength":1},
        "rule_version":{"type":"string","minLength":1},
        "rule_set_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "confidence_policy_version":{"type":"string","minLength":1},
        "evaluator_version":{"type":"string","minLength":1},
        "reproducibility_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "provenance":{"type":"object","minProperties":1},
        "decision_reason":{"type":"string","minLength":1}
      },
      "required":["query_digest","premise_set_digest","premise_model_version","rule_version","rule_set_digest","confidence_policy_version","evaluator_version","reproducibility_digest","provenance","decision_reason"]
    },
    "version_bound_evidence":{"type":"object","minProperties":1}
  },
  "required":["inference_id","conclusion_set","applied_rule_ids","unsupported_steps","evidence","version_bound_evidence"]
}
