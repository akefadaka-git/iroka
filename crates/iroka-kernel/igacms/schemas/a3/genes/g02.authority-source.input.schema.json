{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://iroka.dev/schemas/genes/g02.authority-source/input/1.1.0",
  "title":"G02 authority-source A3 input v1.1.0",
  "type":"object",
  "additionalProperties":false,
  "$defs":{
    "timestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "registration":{
      "type":"object","additionalProperties":false,
      "properties":{
        "authority_id":{"type":"string","minLength":1},
        "source_type":{"enum":["owner","delegated","statutory","system"]},
        "issuer_id":{"type":"string","minLength":1},
        "key_id":{"type":"string","minLength":1},
        "valid_from":{"$ref":"#/$defs/timestamp"},
        "valid_until":{"oneOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "status":{"enum":["active","suspended","revoked"]},
        "signature":{"type":"array","minItems":64,"maxItems":64,"items":{"type":"integer","minimum":0,"maximum":255}}
      },
      "required":["authority_id","source_type","issuer_id","key_id","valid_from","valid_until","status","signature"]
    },
    "mandate":{
      "type":"object","additionalProperties":false,
      "properties":{
        "mandate_ref":{"type":"string","minLength":1},
        "authority_id":{"type":"string","minLength":1},
        "source_type":{"enum":["owner","delegated","statutory","system"]},
        "issuer_id":{"type":"string","minLength":1},
        "key_id":{"type":"string","minLength":1},
        "scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "delegation_chain":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "valid_from":{"$ref":"#/$defs/timestamp"},
        "valid_until":{"oneOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "allow_unbounded":{"type":"boolean"},
        "status":{"enum":["active","suspended","revoked"]},
        "provenance_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "version_bound_evidence_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "signature":{"type":"array","minItems":64,"maxItems":64,"items":{"type":"integer","minimum":0,"maximum":255}}
      },
      "required":["mandate_ref","authority_id","source_type","issuer_id","key_id","scope","delegation_chain","valid_from","valid_until","allow_unbounded","status","provenance_digest","version_bound_evidence_digest","signature"]
    }
  },
  "properties":{
    "authority_id":{"type":"string","minLength":1},
    "source_type":{"enum":["owner","delegated","statutory","system"]},
    "mandate_ref":{"type":"string","minLength":1},
    "valid_from":{"$ref":"#/$defs/timestamp"},
    "valid_until":{"oneOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
    "principal_registration":{"$ref":"#/$defs/registration"},
    "mandate":{"$ref":"#/$defs/mandate"},
    "provenance":{"type":"object","minProperties":1},
    "version_bound_evidence":{"type":"object","minProperties":1}
  },
  "required":["authority_id","source_type","mandate_ref","valid_from","valid_until","principal_registration","mandate","provenance","version_bound_evidence"]
}
