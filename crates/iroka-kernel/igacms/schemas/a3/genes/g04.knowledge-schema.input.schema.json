{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://iroka.dev/schemas/genes/g04.knowledge-schema/input/1.1.0",
  "title":"G04 knowledge-schema A3 input v1.1.0",
  "type":"object","additionalProperties":false,
  "$defs":{
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "field":{
      "type":"object","additionalProperties":false,
      "properties":{
        "field_id":{"type":"string","pattern":"^[a-z][a-z0-9._-]{0,63}$"},
        "name":{"type":"string","minLength":1},
        "value_type":{"enum":["string","integer","number","boolean","object","array"]},
        "required":{"type":"boolean"},
        "nullable":{"type":"boolean"},
        "description":{"type":"string","minLength":1}
      },
      "required":["field_id","name","value_type","required","nullable","description"]
    },
    "constraint":{
      "type":"object","additionalProperties":false,
      "properties":{
        "constraint_id":{"type":"string","pattern":"^[a-z][a-z0-9._-]{0,63}$"},
        "field_id":{"type":"string","pattern":"^[a-z][a-z0-9._-]{0,63}$"},
        "constraint_type":{"enum":["min_length","max_length","minimum","maximum","enum","min_items","max_items","item_type","closed_object","min_properties","max_properties","required_properties","format"]},
        "expression":{"type":"string","pattern":"^field\\.[a-z_]+$"},
        "parameters":{"type":"object","minProperties":1},
        "parameters_digest":{"$ref":"#/$defs/digest"}
      },
      "required":["constraint_id","field_id","constraint_type","expression","parameters","parameters_digest"]
    }
  },
  "properties":{
    "knowledge_type":{"type":"string","pattern":"^[a-z][a-z0-9._-]{0,63}$"},
    "fields":{"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/field"},"uniqueItems":true},
    "constraints":{"type":"array","maxItems":512,"items":{"$ref":"#/$defs/constraint"},"uniqueItems":true},
    "schema_version":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "provenance":{"type":"object","minProperties":1},
    "version_bound_evidence":{"type":"object","minProperties":1}
  },
  "required":["knowledge_type","fields","constraints","schema_version","provenance","version_bound_evidence"]
}
