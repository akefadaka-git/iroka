{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://iroka.dev/schemas/genes/g03.inference-rules/input/1.1.0",
  "title":"G03 inference-rules A3 input v1.1.0",
  "type":"object","additionalProperties":false,
  "$defs":{
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "premise":{
      "type":"object","additionalProperties":false,
      "properties":{
        "premise_id":{"type":"string","minLength":1},
        "epistemic_status":{"enum":["fact","assumption","hypothesis","unknown"]},
        "confidence":{"oneOf":[{"type":"number","minimum":0,"maximum":1},{"type":"null"}]},
        "source_digest":{"$ref":"#/$defs/digest"},
        "context_id":{"type":"string","minLength":1}
      },
      "required":["premise_id","epistemic_status","confidence","source_digest","context_id"]
    },
    "rule":{
      "type":"object","additionalProperties":false,
      "properties":{
        "rule_id":{"type":"string","minLength":1},
        "rule_version":{"type":"string","minLength":1},
        "rule_digest":{"$ref":"#/$defs/digest"},
        "conclusion_id":{"type":"string","minLength":1},
        "conclusion_template":{"type":"string","minLength":1,"pattern":"^[^{}]+$"},
        "antecedent_premise_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "allowed_epistemic_statuses":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["fact","assumption","hypothesis"]}},
        "rule_expression":{"oneOf":[{"const":"AXIOM"},{"type":"string","pattern":"^AND\\([A-Za-z0-9._:-]+(,[A-Za-z0-9._:-]+)*\\)$"}]},
        "query_match":{"type":"string","minLength":1},
        "rule_confidence":{"type":"number","minimum":0,"maximum":1}
      },
      "required":["rule_id","rule_version","rule_digest","conclusion_id","conclusion_template","antecedent_premise_ids","allowed_epistemic_statuses","rule_expression","query_match","rule_confidence"]
    }
  },
  "properties":{
    "rules":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/rule"}},
    "premises":{"type":"array","minItems":1,"maxItems":512,"items":{"$ref":"#/$defs/premise"}},
    "premise_set_digest":{"$ref":"#/$defs/digest"},
    "premise_model_version":{"type":"string","minLength":1},
    "query":{"type":"string","minLength":1},
    "context_id":{"type":"string","minLength":1},
    "rule_version":{"type":"string","minLength":1},
    "rule_set_digest":{"$ref":"#/$defs/digest"},
    "confidence_policy_version":{"type":"string","minLength":1},
    "evaluator_version":{"type":"string","minLength":1},
    "provenance":{"type":"object","minProperties":1,"properties":{
      "rule_registry":{"type":"string","minLength":1},
      "premise_model":{"type":"string","minLength":1},
      "query":{"type":"string","minLength":1},
      "evaluation_context":{"type":"string","minLength":1}
    },"required":["rule_registry","premise_model","query","evaluation_context"]},
    "version_bound_evidence":{"type":"object","minProperties":5,"properties":{
      "premise_set_digest":{"$ref":"#/$defs/digest"},
      "premise_model_version":{"type":"string","minLength":1},
      "rule_set_digest":{"$ref":"#/$defs/digest"},
      "query_digest":{"$ref":"#/$defs/digest"},
      "evaluator_version":{"type":"string","minLength":1}
    },"required":["premise_set_digest","premise_model_version","rule_set_digest","query_digest","evaluator_version"]}
  },
  "required":["rules","premises","premise_set_digest","premise_model_version","query","context_id","rule_version","rule_set_digest","confidence_policy_version","evaluator_version","provenance","version_bound_evidence"]
}
