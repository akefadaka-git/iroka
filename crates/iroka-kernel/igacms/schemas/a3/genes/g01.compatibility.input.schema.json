{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g01.compatibility/input/1.1.0",
  "title": "g01.compatibility input contract v1.1.0",
  "description": "Compatibility input bound to a canonical contract registry, explicit version grammar, authenticated policy and verifiable migration reference.",
  "type": "object",
  "properties": {
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "target_version": {
      "type": "string",
      "minLength": 1
    },
    "contract_registry_id": {
      "type": "string",
      "minLength": 1
    },
    "version_grammar_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "declared_compatible": {
      "type": "boolean"
    },
    "migration_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "migration_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "source_version",
    "target_version",
    "contract_registry_id",
    "version_grammar_id",
    "policy_id",
    "policy_version",
    "policy_issuer_id",
    "policy_digest",
    "declared_compatible",
    "migration_digest",
    "migration_ref",
    "provenance",
    "version_bound_evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "migration_digest": {
            "type": "string"
          }
        },
        "required": [
          "migration_digest"
        ]
      },
      "then": {
        "properties": {
          "migration_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "migration_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "migration_digest": {
            "type": "null"
          }
        },
        "required": [
          "migration_digest"
        ]
      },
      "then": {
        "properties": {
          "migration_ref": {
            "type": "null"
          }
        },
        "required": [
          "migration_ref"
        ]
      }
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    }
  }
}
