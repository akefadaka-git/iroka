{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://iroka.dev/schemas/genes/g03.uncertainty-calculus/input/1.1.0",
  "title":"G03 uncertainty-calculus A3 input v1.1.0",
  "type":"object","additionalProperties":false,
  "$defs":{
    "timestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "evidence":{
      "type":"object","additionalProperties":false,
      "properties":{
        "evidence_id":{"type":"string","minLength":1},
        "direction":{"enum":["supports","refutes","neutral"]},
        "weight":{"type":"number","minimum":0,"maximum":1},
        "reliability":{"type":"number","minimum":0,"maximum":1},
        "epistemic_status":{"enum":["fact","assumption","hypothesis","unknown"]},
        "source_digest":{"$ref":"#/$defs/digest"},
        "provenance_ref":{"type":"string","minLength":1},
        "observed_at":{"$ref":"#/$defs/timestamp"},
        "valid_until":{"oneOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]}
      },
      "required":["evidence_id","direction","weight","reliability","epistemic_status","source_digest","provenance_ref","observed_at","valid_until"]
    },
    "hypothesis":{
      "type":"object","additionalProperties":false,
      "properties":{
        "hypothesis_id":{"type":"string","minLength":1},
        "statement":{"type":"string","minLength":1},
        "prior_probability":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},
        "evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}}
      },
      "required":["hypothesis_id","statement","prior_probability","evidence"]
    },
    "calibration_profile":{
      "type":"object","additionalProperties":false,
      "properties":{
        "profile_id":{"type":"string","minLength":1},
        "profile_version":{"type":"string","minLength":1},
        "status":{"enum":["validated","unvalidated"]},
        "dataset_digest":{"$ref":"#/$defs/digest"},
        "support_likelihood_ratio":{"type":"number","exclusiveMinimum":1},
        "refute_likelihood_ratio":{"type":"number","exclusiveMinimum":1},
        "probability_floor":{"type":"number","exclusiveMinimum":0,"maximum":0.499999},
        "probability_ceiling":{"type":"number","minimum":0.500001,"exclusiveMaximum":1},
        "validated_at":{"$ref":"#/$defs/timestamp"},
        "valid_until":{"$ref":"#/$defs/timestamp"},
        "calibrator_id":{"type":"string","minLength":1}
      },
      "required":["profile_id","profile_version","status","dataset_digest","support_likelihood_ratio","refute_likelihood_ratio","probability_floor","probability_ceiling","validated_at","valid_until","calibrator_id"]
    }
  },
  "properties":{
    "inference_id":{"type":"string","minLength":1},
    "premise_set_digest":{"$ref":"#/$defs/digest"},
    "context_id":{"type":"string","minLength":1},
    "calculation_method":{"const":"weighted_log_odds_v1"},
    "method_version":{"type":"string","minLength":1},
    "calibration_profile":{"$ref":"#/$defs/calibration_profile"},
    "hypotheses":{"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/hypothesis"}},
    "provenance":{"type":"object","minProperties":1},
    "version_bound_evidence":{"type":"object","minProperties":5,"properties":{
      "inference_id":{"type":"string","minLength":1},
      "premise_set_digest":{"$ref":"#/$defs/digest"},
      "calibration_profile_digest":{"$ref":"#/$defs/digest"},
      "method_version":{"type":"string","minLength":1},
      "calculation_method":{"const":"weighted_log_odds_v1"}
    },"required":["inference_id","premise_set_digest","calibration_profile_digest","method_version","calculation_method"]}
  },
  "required":["inference_id","premise_set_digest","context_id","calculation_method","method_version","calibration_profile","hypotheses","provenance","version_bound_evidence"]
}
