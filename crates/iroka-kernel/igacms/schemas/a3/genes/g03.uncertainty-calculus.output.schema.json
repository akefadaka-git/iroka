{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://iroka.dev/schemas/genes/g03.uncertainty-calculus/output/1.1.0",
  "title":"G03 uncertainty-calculus A3 output v1.1.0",
  "type":"object","additionalProperties":false,
  "$defs":{
    "estimate":{
      "type":"object","additionalProperties":false,
      "properties":{
        "hypothesis_id":{"type":"string","minLength":1},
        "statement":{"type":"string","minLength":1},
        "prior_probability":{"oneOf":[{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},{"type":"null"}]},
        "posterior_probability":{"oneOf":[{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},{"type":"null"}]},
        "normalized_entropy":{"oneOf":[{"type":"number","minimum":0,"maximum":1},{"type":"null"}]},
        "supporting_evidence_count":{"type":"integer","minimum":0},
        "refuting_evidence_count":{"type":"integer","minimum":0},
        "evidence_conflict":{"type":"boolean"},
        "used_evidence_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "uncertainty_reason":{"oneOf":[{"type":"string","minLength":1},{"type":"null"}]}
      },
      "required":["hypothesis_id","statement","prior_probability","posterior_probability","normalized_entropy","supporting_evidence_count","refuting_evidence_count","evidence_conflict","used_evidence_ids","uncertainty_reason"]
    },
    "unresolved":{
      "type":"object","additionalProperties":false,
      "properties":{
        "hypothesis_id":{"type":"string","minLength":1},
        "evidence_id":{"type":"string","minLength":1},
        "reason":{"type":"string","minLength":1}
      },
      "required":["hypothesis_id","evidence_id","reason"]
    }
  },
  "properties":{
    "calculation_valid":{"type":"boolean"},
    "hypothesis_estimates":{"type":"array","items":{"$ref":"#/$defs/estimate"}},
    "unresolved_evidence":{"type":"array","items":{"$ref":"#/$defs/unresolved"}},
    "evidence":{
      "type":"object","additionalProperties":false,
      "properties":{
        "method_version":{"type":"string","minLength":1},
        "calibration_profile_id":{"type":"string","minLength":1},
        "calibration_profile_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "calibration_dataset_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "inference_id":{"type":"string","minLength":1},
        "premise_set_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "input_hypothesis_count":{"type":"integer","minimum":0},
        "total_evidence_count":{"type":"integer","minimum":0},
        "used_evidence_count":{"type":"integer","minimum":0},
        "unresolved_evidence_count":{"type":"integer","minimum":0},
        "complete_disposition":{"type":"boolean"},
        "probability_semantics":{"enum":["calibrated_posterior_under_registered_profile","no_calibrated_probability"]},
        "normalization_scope":{"const":"independent_per_hypothesis"},
        "calculation_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "decision_reason":{"type":"string","minLength":1}
      },
      "required":["method_version","calibration_profile_id","calibration_profile_digest","calibration_dataset_digest","inference_id","premise_set_digest","input_hypothesis_count","total_evidence_count","used_evidence_count","unresolved_evidence_count","complete_disposition","probability_semantics","normalization_scope","calculation_digest","decision_reason"]
    },
    "version_bound_evidence":{"type":"object","minProperties":1}
  },
  "required":["calculation_valid","hypothesis_estimates","unresolved_evidence","evidence","version_bound_evidence"],
  "allOf":[
    {
      "if":{"properties":{"calculation_valid":{"const":false}},"required":["calculation_valid"]},
      "then":{"properties":{
        "hypothesis_estimates":{"items":{"properties":{"posterior_probability":{"type":"null"},"normalized_entropy":{"type":"null"}}}},
        "evidence":{"properties":{"probability_semantics":{"const":"no_calibrated_probability"}}}
      }}
    }
  ]
}
