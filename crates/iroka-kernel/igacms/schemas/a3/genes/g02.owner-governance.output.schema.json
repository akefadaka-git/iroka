{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://iroka.dev/schemas/genes/g02.owner-governance/output/1.1.0",
  "title":"G02 Owner-governance A3 output v1.1.0",
  "type":"object","additionalProperties":false,
  "properties":{
    "decision_id":{"type":"string","minLength":1},
    "approval_valid":{"type":"boolean"},
    "authorized_scope":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "decision":{"enum":["approved","rejected","expired"]},
    "evidence":{
      "type":"object","additionalProperties":false,
      "properties":{
        "owner_identity_verified":{"type":"boolean"},
        "approval_signature_verified":{"type":"boolean"},
        "register_snapshot_verified":{"type":"boolean"},
        "decision_register_entry_unique":{"type":"boolean"},
        "scope_exact_match":{"type":"boolean"},
        "temporal_validity_verified":{"type":"boolean"},
        "revocation_checked":{"type":"boolean"},
        "register_sequence":{"type":"integer","minimum":0},
        "evaluated_at":{"type":"string","pattern":"^unix:[0-9]+$"},
        "provenance":{"type":"object","minProperties":1},
        "decision_reason":{"type":"string","minLength":1}
      },
      "required":["owner_identity_verified","approval_signature_verified","register_snapshot_verified","decision_register_entry_unique","scope_exact_match","temporal_validity_verified","revocation_checked","register_sequence","evaluated_at","provenance","decision_reason"]
    },
    "version_bound_evidence":{"type":"object","minProperties":1},
    "safeguard_conflicts":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "safeguards_satisfied":{"type":"boolean"},
    "execution_authorized":{"const":false}
  },
  "required":["decision_id","approval_valid","authorized_scope","decision","evidence","version_bound_evidence","safeguard_conflicts","safeguards_satisfied","execution_authorized"],
  "allOf":[
    {
      "if":{"properties":{"decision":{"const":"approved"}},"required":["decision"]},
      "then":{"properties":{"approval_valid":{"const":true},"authorized_scope":{"minItems":1}}}
    },
    {
      "if":{"properties":{"decision":{"enum":["rejected","expired"]}},"required":["decision"]},
      "then":{"properties":{"authorized_scope":{"maxItems":0}}}
    },
    {
      "if":{"properties":{"approval_valid":{"const":false}},"required":["approval_valid"]},
      "then":{"properties":{"decision":{"enum":["rejected","expired"]},"authorized_scope":{"maxItems":0}}}
    },
    {
      "if":{"properties":{"safeguard_conflicts":{"minItems":1}},"required":["safeguard_conflicts"]},
      "then":{"properties":{"safeguards_satisfied":{"const":false},"execution_authorized":{"const":false}}}
    }
  ]
}
