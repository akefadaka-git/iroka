{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://iroka.dev/schemas/genes/g03.premise-model/input/1.1.0",
  "title":"G03 premise-model A3 input v1.1.0",
  "type":"object","additionalProperties":false,
  "$defs":{
    "timestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "source_ref":{
      "type":"object","additionalProperties":false,
      "properties":{
        "source_id":{"type":"string","minLength":1},
        "source_type":{"type":"string","minLength":1},
        "source_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "provenance_ref":{"type":"string","minLength":1},
        "observed_at":{"oneOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},
        "observation_time_unknown_reason":{"oneOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "valid_until":{"oneOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]}
      },
      "required":["source_id","source_type","source_digest","provenance_ref","observed_at","observation_time_unknown_reason","valid_until"],
      "allOf":[
        {"if":{"properties":{"observed_at":{"type":"null"}},"required":["observed_at"]},"then":{"properties":{"observation_time_unknown_reason":{"type":"string","minLength":1}}}}
      ]
    },
    "premise":{
      "type":"object","additionalProperties":false,
      "properties":{
        "premise_id":{"type":"string","minLength":1},
        "statement":{"type":"string","minLength":1},
        "epistemic_status":{"enum":["fact","assumption","hypothesis","unknown"]},
        "source_refs":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/source_ref"}},
        "source_unavailable_reason":{"oneOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "confidence":{"oneOf":[{"type":"number","minimum":0,"maximum":1},{"type":"null"}]},
        "context":{"type":"string","minLength":1}
      },
      "required":["premise_id","statement","epistemic_status","source_refs","source_unavailable_reason","confidence","context"],
      "allOf":[
        {"if":{"properties":{"epistemic_status":{"const":"fact"}},"required":["epistemic_status"]},"then":{"properties":{"source_refs":{"minItems":1}}}},
        {"if":{"properties":{"source_refs":{"maxItems":0}},"required":["source_refs"]},"then":{"properties":{"source_unavailable_reason":{"type":"string","minLength":1}}}}
      ]
    }
  },
  "properties":{
    "premises":{"type":"array","minItems":1,"maxItems":512,"items":{"$ref":"#/$defs/premise"}},
    "context_id":{"type":"string","minLength":1},
    "model_version":{"type":"string","minLength":1},
    "normalization_policy_version":{"type":"string","minLength":1},
    "provenance":{"type":"object","minProperties":1},
    "version_bound_evidence":{"type":"object","minProperties":1}
  },
  "required":["premises","context_id","model_version","normalization_policy_version","provenance","version_bound_evidence"]
}
