{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g01.lineage/input/1.1.0",
  "title": "G01 identity-lineage A3 input v1.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "subject_id": {"type":"string","minLength":1},
    "predecessor_id": {"oneOf":[{"type":"null"},{"type":"string","minLength":1}]},
    "relationship": {"enum":["root","derived","successor"]},
    "proof_digest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "epoch": {"type":"integer","minimum":0},
    "lineage_chain": {
      "type":"array","minItems":1,"maxItems":128,
      "items": {
        "type":"object","additionalProperties":false,
        "properties": {
          "subject_id":{"type":"string","minLength":1},
          "predecessor_id":{"oneOf":[{"type":"null"},{"type":"string","minLength":1}]},
          "relationship":{"enum":["root","derived","successor"]},
          "epoch":{"type":"integer","minimum":0},
          "issuer_id":{"type":"string","minLength":1},
          "key_id":{"type":"string","minLength":1},
          "issued_at":{"type":"integer","minimum":0},
          "expires_at":{"type":"integer","minimum":1},
          "nonce":{"type":"string","minLength":16},
          "provenance_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "version_evidence_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "proof_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "signature":{"type":"array","minItems":64,"maxItems":64,"items":{"type":"integer","minimum":0,"maximum":255}}
        },
        "required":["subject_id","predecessor_id","relationship","epoch","issuer_id","key_id","issued_at","expires_at","nonce","provenance_digest","version_evidence_digest","proof_digest","signature"]
      }
    },
    "provenance":{"type":"object","minProperties":1},
    "version_bound_evidence":{"type":"object","minProperties":1}
  },
  "required":["subject_id","predecessor_id","relationship","proof_digest","epoch","lineage_chain","provenance","version_bound_evidence"]
}
