{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g01.lineage/input/1.0.0",
  "title": "g01.lineage input contract v1.0.0",
  "description": "input contract for g01.lineage: subject identity, predecessor identity, succession proof, lineage epoch",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "predecessor_id": {
      "type": "string",
      "minLength": 1
    },
    "relationship": {
      "type": "string",
      "enum": [
        "derived",
        "successor",
        "merged"
      ]
    },
    "proof_digest": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "subject_id",
    "predecessor_id",
    "relationship",
    "proof_digest",
    "epoch",
    "provenance"
  ],
  "additionalProperties": false
}
