{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g08.coordination-state/output/1.0.0",
  "title": "Coordination state — output",
  "description": "Normative output contract for g08.coordination-state v1.0.0, derived from the Owner-approved amendment.",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    },
    "conflicts_item": {
      "type": "object",
      "properties": {
        "conflict_id": {
          "type": "string",
          "minLength": 1
        },
        "participant_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "resource_ref": {
          "type": "string",
          "minLength": 1
        },
        "conflict_type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "conflict_id",
        "participant_ids",
        "resource_ref",
        "conflict_type",
        "description"
      ],
      "additionalProperties": false,
      "$anchor": "g08-coordination-state-output-conflicts-item-v1-0-0"
    },
    "stale_participants_item": {
      "type": "string",
      "minLength": 1,
      "$anchor": "g08-coordination-state-output-stale_participants-item-v1-0-0"
    }
  },
  "properties": {
    "run_id": {
      "type": "string",
      "description": "run_id — approved output field for g08.coordination-state"
    },
    "canonical_state": {
      "type": "object",
      "properties": {
        "state_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "participant_id": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "minLength": 1
              },
              "lease_epoch": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "participant_id",
              "state",
              "lease_epoch"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "checkpoint_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "state_digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state_version",
        "sequence",
        "participants",
        "checkpoint_refs",
        "state_digest"
      ],
      "additionalProperties": false
    },
    "state_digest": {
      "type": "string",
      "description": "state_digest — approved output field for g08.coordination-state"
    },
    "conflicts": {
      "type": "array",
      "description": "conflicts — approved output field for g08.coordination-state",
      "items": {
        "$ref": "#/$defs/conflicts_item"
      },
      "x-genesis-collection-rules": {
        "uniqueBy": [
          "conflict_id"
        ],
        "rule": "participant references resolve; conflict state must not be silently overwritten"
      }
    },
    "stale_participants": {
      "type": "array",
      "description": "stale_participants — approved output field for g08.coordination-state",
      "items": {
        "$ref": "#/$defs/stale_participants_item"
      },
      "uniqueItems": true,
      "x-genesis-collection-rules": {
        "rule": "unique IDs drawn from input participants; stale classification must be based on lease/checkpoint freshness policy"
      }
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "required": [
    "run_id",
    "canonical_state",
    "state_digest",
    "conflicts",
    "stale_participants",
    "evidence"
  ],
  "additionalProperties": false
}
