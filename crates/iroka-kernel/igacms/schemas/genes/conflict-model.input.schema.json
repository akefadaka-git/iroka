{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g04.conflict-model/input/1.0.0",
  "title": "Conflict model — input",
  "description": "Normative input contract for g04.conflict-model v1.0.0, derived from the Owner-approved amendment.",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    },
    "claims_item": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object_value": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "claim_id",
        "subject",
        "predicate",
        "object_value",
        "source_ids",
        "confidence"
      ],
      "additionalProperties": false,
      "$anchor": "g04-conflict-model-input-claims-item-v1-0-0"
    },
    "sources_item": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_digest": {
          "type": "string",
          "minLength": 1
        },
        "trust_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source_id",
        "source_ref",
        "source_digest",
        "trust_ref"
      ],
      "additionalProperties": false,
      "$anchor": "g04-conflict-model-input-sources-item-v1-0-0"
    },
    "relations_item": {
      "type": "object",
      "properties": {
        "relation_id": {
          "type": "string",
          "minLength": 1
        },
        "left_claim_id": {
          "type": "string",
          "minLength": 1
        },
        "right_claim_id": {
          "type": "string",
          "minLength": 1
        },
        "relation_type": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts",
            "duplicates",
            "depends_on"
          ]
        }
      },
      "required": [
        "relation_id",
        "left_claim_id",
        "right_claim_id",
        "relation_type"
      ],
      "additionalProperties": false,
      "$anchor": "g04-conflict-model-input-relations-item-v1-0-0"
    }
  },
  "properties": {
    "claims": {
      "type": "array",
      "description": "claims — approved input field for g04.conflict-model",
      "items": {
        "$ref": "#/$defs/claims_item"
      },
      "minItems": 1,
      "x-genesis-collection-rules": {
        "minItems": 1,
        "uniqueBy": [
          "claim_id"
        ],
        "rule": "all source_ids resolve to sources"
      }
    },
    "sources": {
      "type": "array",
      "description": "sources — approved input field for g04.conflict-model",
      "items": {
        "$ref": "#/$defs/sources_item"
      },
      "minItems": 1,
      "x-genesis-collection-rules": {
        "minItems": 1,
        "uniqueBy": [
          "source_id"
        ]
      }
    },
    "relations": {
      "type": "array",
      "description": "relations — approved input field for g04.conflict-model",
      "items": {
        "$ref": "#/$defs/relations_item"
      },
      "x-genesis-collection-rules": {
        "uniqueBy": [
          "relation_id"
        ],
        "rule": "both claim IDs resolve; self-relations rejected"
      }
    },
    "policy_id": {
      "type": "string",
      "description": "policy_id — approved input field for g04.conflict-model"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "claims",
    "sources",
    "relations",
    "policy_id",
    "provenance",
    "version_bound_evidence"
  ],
  "additionalProperties": false
}
