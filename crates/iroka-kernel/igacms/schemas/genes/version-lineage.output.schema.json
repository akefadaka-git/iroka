{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g12.version-lineage/output/1.0.0",
  "title": "Version lineage — output",
  "description": "Normative output contract for g12.version-lineage v1.0.0.",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    },
    "ancestry_item": {
      "type": "object",
      "properties": {
        "gene_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "type": "string",
          "minLength": 1
        },
        "parent_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "mutation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "gene_id",
        "version",
        "artifact_digest",
        "parent_digest",
        "mutation_id",
        "epoch"
      ],
      "additionalProperties": false,
      "$anchor": "g12-version-lineage-output-ancestry-item-v1-0-0"
    }
  },
  "properties": {
    "lineage_digest": {
      "type": "string",
      "description": "lineage_digest — approved output field for g12.version-lineage"
    },
    "linked": {
      "type": "boolean",
      "description": "linked — approved output field for g12.version-lineage"
    },
    "epoch_monotonic": {
      "type": "boolean",
      "description": "epoch_monotonic — approved output field for g12.version-lineage"
    },
    "ancestry": {
      "type": "array",
      "description": "ancestry — approved output field for g12.version-lineage",
      "items": {
        "$ref": "#/$defs/ancestry_item"
      },
      "minItems": 1,
      "x-genesis-collection-rules": {
        "minItems": 1,
        "uniqueBy": [
          "gene_id",
          "version",
          "artifact_digest"
        ],
        "order": "oldest ancestor to candidate",
        "rule": "digest links form one acyclic chain; epochs strictly increase; candidate must match output artifact"
      }
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "required": [
    "lineage_digest",
    "linked",
    "epoch_monotonic",
    "ancestry",
    "evidence"
  ],
  "additionalProperties": false
}