{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g10.learning-input/output/1.0.0",
  "title": "Learning input — output",
  "description": "Normative output contract for g10.learning-input v1.0.0.",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    }
  },
  "properties": {
    "learning_batch_id": {
      "type": "string",
      "description": "learning_batch_id — approved output field for g10.learning-input"
    },
    "eligible_observations": {
      "type": "array",
      "description": "eligible_observations — approved output field for g10.learning-input"
    },
    "excluded_observations": {
      "type": "array",
      "description": "excluded_observations — approved output field for g10.learning-input"
    },
    "eligibility_digest": {
      "type": "string",
      "description": "eligibility_digest — approved output field for g10.learning-input"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "learning_batch_id",
    "eligible_observations",
    "excluded_observations",
    "eligibility_digest",
    "evidence",
    "version_bound_evidence"
  ],
  "additionalProperties": false
}
