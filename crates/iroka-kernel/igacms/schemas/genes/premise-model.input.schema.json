{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g03.premise-model/input/1.0.0",
  "title": "g03.premise-model input contract v1.0.0",
  "description": "input contract for g03.premise-model: premise statements, source references, confidence values, context",
  "type": "object",
  "properties": {
    "premises": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/premises_item"
      },
      "minItems": 1,
      "x-genesis-collection-rules": {
        "minItems": 1,
        "uniqueBy": [
          "premise_id"
        ],
        "order": "input order preserved; no implicit reordering"
      }
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "premises",
    "context_id",
    "model_version",
    "provenance",
    "version_bound_evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    },
    "premises_item": {
      "type": "object",
      "properties": {
        "premise_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "premise_id",
        "statement",
        "source_refs",
        "confidence",
        "context"
      ],
      "additionalProperties": false,
      "$anchor": "g03-premise-model-input-premises-item-v1-0-0"
    }
  }
}
