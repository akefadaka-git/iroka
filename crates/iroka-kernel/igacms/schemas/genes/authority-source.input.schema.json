{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g02.authority-source/input/1.0.0",
  "title": "g02.authority-source input contract v1.0.0",
  "description": "input contract for g02.authority-source: authority principal, source class, mandate reference, validity interval",
  "type": "object",
  "properties": {
    "authority_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": [
        "owner",
        "delegated",
        "statutory",
        "system"
      ]
    },
    "mandate_ref": {
      "type": "string",
      "minLength": 1
    },
    "valid_from": {
      "type": "string",
      "minLength": 1
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "authority_id",
    "source_type",
    "mandate_ref",
    "valid_from",
    "valid_until",
    "provenance",
    "version_bound_evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    }
  }
}
