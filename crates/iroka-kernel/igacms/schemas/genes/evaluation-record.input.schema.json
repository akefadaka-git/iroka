{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g10.evaluation-record/input/1.0.0",
  "title": "Evaluation record — input",
  "description": "Normative input contract for g10.evaluation-record v1.0.0.",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    }
  },
  "properties": {
    "proposal_id": {
      "type": "string",
      "description": "proposal_id — approved input field for g10.evaluation-record"
    },
    "suite_digest": {
      "type": "string",
      "description": "suite_digest — approved input field for g10.evaluation-record"
    },
    "baseline_metrics": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric_id": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "aggregation": {
                "type": "string",
                "enum": [
                  "mean",
                  "median",
                  "min",
                  "max",
                  "sum",
                  "count",
                  "p95",
                  "p99"
                ]
              },
              "window_seconds": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "metric_id",
              "value",
              "unit",
              "aggregation",
              "window_seconds"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "metrics"
      ],
      "additionalProperties": false
    },
    "candidate_metrics": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric_id": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "aggregation": {
                "type": "string",
                "enum": [
                  "mean",
                  "median",
                  "min",
                  "max",
                  "sum",
                  "count",
                  "p95",
                  "p99"
                ]
              },
              "window_seconds": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "metric_id",
              "value",
              "unit",
              "aggregation",
              "window_seconds"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "metrics"
      ],
      "additionalProperties": false
    },
    "evaluator_id": {
      "type": "string",
      "description": "evaluator_id — approved input field for g10.evaluation-record"
    },
    "environment_digest": {
      "type": "string",
      "description": "environment_digest — approved input field for g10.evaluation-record"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "proposal_id",
    "suite_digest",
    "baseline_metrics",
    "candidate_metrics",
    "evaluator_id",
    "environment_digest",
    "provenance",
    "version_bound_evidence"
  ],
  "additionalProperties": false
}
