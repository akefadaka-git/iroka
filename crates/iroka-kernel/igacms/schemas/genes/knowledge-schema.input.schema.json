{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g04.knowledge-schema/input/1.0.0",
  "title": "g04.knowledge-schema input contract v1.0.0",
  "description": "input contract for g04.knowledge-schema: knowledge type, field definitions, constraints, schema version",
  "type": "object",
  "properties": {
    "knowledge_type": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "array",
      "items": {}
    },
    "constraints": {
      "type": "array",
      "items": {}
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "knowledge_type",
    "fields",
    "constraints",
    "schema_version",
    "provenance",
    "version_bound_evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    }
  }
}
