{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g02.decision-register/output/1.0.0",
  "title": "g02.decision-register output contract v1.0.0",
  "description": "output contract for g02.decision-register: decision identifier, authority, decision text digest, status, supersession link",
  "type": "object",
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded": {
      "type": "boolean"
    },
    "canonical_digest": {
      "type": "string",
      "minLength": 1
    },
    "register_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "required": [
    "decision_id",
    "recorded",
    "canonical_digest",
    "register_sequence",
    "evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    }
  }
}
