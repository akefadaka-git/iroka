{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g02.decision-register/output/1.0.0",
  "title": "g02.decision-register output contract v1.0.0",
  "description": "output contract for g02.decision-register: decision identifier, authority, decision text digest, status, supersession link",
  "type": "object",
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded": {
      "type": "boolean"
    },
    "canonical_digest": {
      "type": "string",
      "minLength": 1
    },
    "register_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "decision_id",
    "recorded",
    "canonical_digest",
    "register_sequence",
    "evidence"
  ],
  "additionalProperties": false
}
