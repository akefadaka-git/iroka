{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g08.coordination-state/input/1.0.0",
  "title": "Coordination state — input",
  "description": "Normative input contract for g08.coordination-state v1.0.0, derived from the Owner-approved amendment.",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    },
    "participants_item": {
      "type": "object",
      "properties": {
        "participant_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "lease_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "participant_id",
        "state",
        "lease_epoch",
        "checkpoint_ref",
        "updated_at"
      ],
      "additionalProperties": false,
      "$anchor": "g08-coordination-state-input-participants-item-v1-0-0"
    },
    "checkpoint_refs_item": {
      "type": "string",
      "minLength": 1,
      "$anchor": "g08-coordination-state-input-checkpoint_refs-item-v1-0-0"
    }
  },
  "properties": {
    "run_id": {
      "type": "string",
      "description": "run_id — approved input field for g08.coordination-state"
    },
    "participants": {
      "type": "array",
      "description": "participants — approved input field for g08.coordination-state",
      "items": {
        "$ref": "#/$defs/participants_item"
      },
      "minItems": 1,
      "x-genesis-collection-rules": {
        "minItems": 1,
        "uniqueBy": [
          "participant_id"
        ],
        "rule": "lease epochs non-negative and monotonic per participant"
      }
    },
    "lease_epochs": {
      "type": "object",
      "description": "lease_epochs — approved input field for g08.coordination-state"
    },
    "checkpoint_refs": {
      "type": "array",
      "description": "checkpoint_refs — approved input field for g08.coordination-state",
      "items": {
        "$ref": "#/$defs/checkpoint_refs_item"
      },
      "uniqueItems": true,
      "x-genesis-collection-rules": {
        "rule": "unique immutable checkpoint references; every participant checkpoint_ref must be present when non-null"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "run_id",
    "participants",
    "lease_epochs",
    "checkpoint_refs",
    "provenance",
    "version_bound_evidence"
  ],
  "additionalProperties": false
}
