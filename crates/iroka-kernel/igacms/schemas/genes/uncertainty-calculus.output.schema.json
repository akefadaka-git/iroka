{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g03.uncertainty-calculus/output/1.0.0",
  "title": "g03.uncertainty-calculus output contract v1.0.0",
  "description": "output contract for g03.uncertainty-calculus: hypotheses, evidence weights, calibration profile, calculation method",
  "type": "object",
  "properties": {
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "estimates": {
      "type": "array",
      "items": {}
    },
    "uncertainty_bounds": {
      "type": "object",
      "additionalProperties": true
    },
    "calibration_status": {
      "type": "string",
      "enum": [
        "valid",
        "insufficient",
        "invalid"
      ]
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "assessment_id",
    "estimates",
    "uncertainty_bounds",
    "calibration_status",
    "evidence",
    "version_bound_evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    }
  }
}
