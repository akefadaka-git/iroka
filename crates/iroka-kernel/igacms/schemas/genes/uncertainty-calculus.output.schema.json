{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g03.uncertainty-calculus/output/1.0.0",
  "title": "g03.uncertainty-calculus output contract v1.0.0",
  "description": "output contract for g03.uncertainty-calculus: hypotheses, evidence weights, calibration profile, calculation method",
  "type": "object",
  "properties": {
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "estimates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/estimates_item"
      },
      "x-genesis-collection-rules": {
        "uniqueBy": [
          "hypothesis_id"
        ],
        "rule": "lower_bound <= estimate <= upper_bound; bounds and estimate in [0,1]"
      }
    },
    "uncertainty_bounds": {
      "type": "object",
      "properties": {
        "calibration_method": {
          "type": "string",
          "minLength": 1
        },
        "probability_scale": {
          "type": "string",
          "enum": [
            "unit_interval"
          ]
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hypothesis_id": {
                "type": "string",
                "minLength": 1
              },
              "lower_bound": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "upper_bound": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "hypothesis_id",
              "lower_bound",
              "upper_bound"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "calibration_method",
        "probability_scale",
        "hypotheses"
      ],
      "additionalProperties": false
    },
    "calibration_status": {
      "type": "string",
      "enum": [
        "valid",
        "insufficient",
        "invalid"
      ]
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "required": [
    "assessment_id",
    "estimates",
    "uncertainty_bounds",
    "calibration_status",
    "evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    },
    "estimates_item": {
      "type": "object",
      "properties": {
        "hypothesis_id": {
          "type": "string",
          "minLength": 1
        },
        "estimate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lower_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "upper_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "hypothesis_id",
        "estimate",
        "lower_bound",
        "upper_bound",
        "method"
      ],
      "additionalProperties": false,
      "$anchor": "g03-uncertainty-calculus-output-estimates-item-v1-0-0"
    }
  }
}
