{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g08.scheduler-policy/input/1.0.0",
  "title": "Scheduler policy — input",
  "description": "Normative input contract for g08.scheduler-policy v1.0.0, derived from the Owner-approved amendment.",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    },
    "task_classes_item": {
      "type": "object",
      "properties": {
        "class_id": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer"
        },
        "quota": {
          "type": "number",
          "minimum": 0
        },
        "deadline_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "class_id",
        "priority",
        "quota",
        "deadline_at"
      ],
      "additionalProperties": false,
      "$anchor": "g08-scheduler-policy-input-task_classes-item-v1-0-0"
    }
  },
  "properties": {
    "policy_id": {
      "type": "string",
      "description": "policy_id — approved input field for g08.scheduler-policy"
    },
    "task_classes": {
      "type": "array",
      "description": "task_classes — approved input field for g08.scheduler-policy",
      "items": {
        "$ref": "#/$defs/task_classes_item"
      },
      "minItems": 1,
      "x-genesis-collection-rules": {
        "minItems": 1,
        "uniqueBy": [
          "class_id"
        ],
        "rule": "priority is an integer; quota is non-negative; deadline is an absolute timestamp when present"
      }
    },
    "priorities": {
      "type": "object",
      "properties": {
        "ordering": {
          "type": "string",
          "enum": [
            "ascending"
          ]
        },
        "lower_number_is_higher": {
          "const": true
        },
        "by_task_class": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "class_id": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "integer"
              }
            },
            "required": [
              "class_id",
              "priority"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "ordering",
        "lower_number_is_higher",
        "by_task_class"
      ],
      "additionalProperties": false
    },
    "quotas": {
      "type": "object",
      "properties": {
        "by_task_class": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "class_id": {
                "type": "string",
                "minLength": 1
              },
              "resource": {
                "type": "string",
                "enum": [
                  "cpu",
                  "memory",
                  "storage",
                  "execution_time",
                  "concurrency",
                  "token_consumption"
                ]
              },
              "limit": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "window_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "burst_limit": {
                "type": "number",
                "minimum": 0
              },
              "reset_policy": {
                "type": "string",
                "enum": [
                  "fixed",
                  "rolling"
                ]
              }
            },
            "required": [
              "class_id",
              "resource",
              "limit",
              "unit",
              "window_seconds",
              "burst_limit",
              "reset_policy"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "by_task_class"
      ],
      "additionalProperties": false
    },
    "deadlines": {
      "type": "object",
      "properties": {
        "by_task_class": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "class_id": {
                "type": "string",
                "minLength": 1
              },
              "deadline_at": {
                "type": "string",
                "format": "date-time"
              },
              "expiry_behavior": {
                "type": "string",
                "enum": [
                  "reject",
                  "cancel",
                  "deprioritize"
                ]
              }
            },
            "required": [
              "class_id",
              "deadline_at",
              "expiry_behavior"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "by_task_class"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "policy_id",
    "task_classes",
    "priorities",
    "quotas",
    "deadlines",
    "provenance",
    "version_bound_evidence"
  ],
  "additionalProperties": false
}
