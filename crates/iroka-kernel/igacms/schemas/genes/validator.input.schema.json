{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g11.validator/input/1.0.0",
  "title": "Validator — input",
  "description": "Normative input contract for g11.validator v1.0.0.",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    },
    "contract_ids_item": {
      "type": "string",
      "minLength": 1,
      "$anchor": "g11-validator-input-contract_ids-item-v1-0-0"
    }
  },
  "properties": {
    "artifact_ref": {
      "type": "string",
      "description": "artifact_ref — approved input field for g11.validator"
    },
    "contract_ids": {
      "type": "array",
      "description": "contract_ids — approved input field for g11.validator",
      "items": {
        "$ref": "#/$defs/contract_ids_item"
      },
      "minItems": 1,
      "uniqueItems": true,
      "x-genesis-collection-rules": {
        "minItems": 1,
        "rule": "unique IDs; every ID resolves to a version-pinned contract"
      }
    },
    "validator_version": {
      "type": "string",
      "description": "validator_version — approved input field for g11.validator"
    },
    "policy_digest": {
      "type": "string",
      "description": "policy_digest — approved input field for g11.validator"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "artifact_ref",
    "contract_ids",
    "validator_version",
    "policy_digest",
    "provenance",
    "version_bound_evidence"
  ],
  "additionalProperties": false
}
