{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g01.identity-root/output/1.1.0",
  "title": "g01.identity-root output contract v1.1.0",
  "description": "Identity-root result with evidence sufficient to reproduce trust, issuer, key-status and algorithm-policy decisions.",
  "type": "object",
  "properties": {
    "root_id": {
      "type": "string",
      "minLength": 1
    },
    "verified": {
      "type": "boolean"
    },
    "trust_decision": {
      "type": "string",
      "enum": [
        "trusted",
        "untrusted",
        "revoked"
      ]
    },
    "evaluated_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "root_id",
    "verified",
    "trust_decision",
    "evaluated_epoch",
    "evidence",
    "version_bound_evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "trust_decision": {
            "const": "trusted"
          }
        },
        "required": [
          "trust_decision"
        ]
      },
      "then": {
        "properties": {
          "verified": {
            "const": true
          }
        },
        "required": [
          "verified"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "trust_decision": {
            "enum": [
              "untrusted",
              "revoked"
            ]
          }
        },
        "required": [
          "trust_decision"
        ]
      },
      "then": {
        "properties": {
          "verified": {
            "const": false
          }
        },
        "required": [
          "verified"
        ]
      }
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "issuer_link": {
      "type": "object",
      "properties": {
        "issuer_id": {
          "type": "string",
          "minLength": 1
        },
        "key_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "trusted",
            "untrusted",
            "revoked"
          ]
        }
      },
      "required": [
        "issuer_id",
        "key_fingerprint",
        "status"
      ],
      "additionalProperties": false
    },
    "algorithm_policy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "allowed": {
          "type": "boolean"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "algorithm",
        "allowed"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        },
        "issuer_chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/issuer_link"
          }
        },
        "key_status": {
          "type": "string",
          "enum": [
            "active",
            "suspended",
            "revoked"
          ]
        },
        "algorithm_policy": {
          "$ref": "#/$defs/algorithm_policy"
        },
        "decision_rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence",
        "issuer_chain",
        "key_status",
        "algorithm_policy",
        "decision_rationale"
      ],
      "additionalProperties": false
    }
  }
}
