{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g11.attestation/output/1.0.0",
  "title": "Attestation — output",
  "description": "Normative output contract for g11.attestation v1.0.0.",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    }
  },
  "properties": {
    "attestation_id": {
      "type": "string",
      "description": "attestation_id — approved output field for g11.attestation"
    },
    "subject_digest": {
      "type": "string",
      "description": "subject_digest — approved output field for g11.attestation"
    },
    "attester_id": {
      "type": "string",
      "description": "attester_id — approved output field for g11.attestation"
    },
    "signature": {
      "type": "string",
      "description": "signature — approved output field for g11.attestation"
    },
    "issued_at": {
      "type": "string",
      "description": "issued_at — approved output field for g11.attestation"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "valid",
        "invalid"
      ],
      "description": "verification_status — approved output field for g11.attestation"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "attestation_id",
    "subject_digest",
    "attester_id",
    "signature",
    "issued_at",
    "verification_status",
    "evidence",
    "version_bound_evidence"
  ],
  "additionalProperties": false
}
