{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g06.source-trust/output/1.0.0",
  "title": "Source trust — output",
  "description": "Normative output contract for g06.source-trust v1.0.0, derived from the Owner-approved amendment.",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    }
  },
  "properties": {
    "source_id": {
      "type": "string",
      "description": "source_id — approved output field for g06.source-trust"
    },
    "trust_level": {
      "type": "string",
      "enum": [
        "trusted",
        "untrusted",
        "revoked",
        "unknown"
      ],
      "description": "trust_level — approved output field for g06.source-trust"
    },
    "signature_valid": {
      "type": "boolean",
      "description": "signature_valid — approved output field for g06.source-trust"
    },
    "policy_digest": {
      "type": "string",
      "description": "policy_digest — approved output field for g06.source-trust"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "required": [
    "source_id",
    "trust_level",
    "signature_valid",
    "policy_digest",
    "evidence"
  ],
  "additionalProperties": false
}