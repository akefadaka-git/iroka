{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g04.knowledge-schema/output/1.0.0",
  "title": "Knowledge schema — output",
  "description": "Normative output contract for g04.knowledge-schema v1.0.0, derived from the Owner-approved amendment.",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    }
  },
  "properties": {
    "schema_id": {
      "type": "string",
      "description": "schema_id — approved output field for g04.knowledge-schema"
    },
    "normalized_schema": {
      "type": "object",
      "properties": {
        "dialect": {
          "type": "string",
          "enum": [
            "https://json-schema.org/draft/2020-12/schema"
          ]
        },
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "type",
              "required"
            ],
            "additionalProperties": false
          }
        },
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "compatibility": {
          "type": "string",
          "enum": [
            "backward-compatible",
            "breaking",
            "unknown"
          ]
        },
        "schema_digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "dialect",
        "schema_id",
        "schema_version",
        "properties",
        "required_fields",
        "compatibility",
        "schema_digest"
      ],
      "additionalProperties": false
    },
    "schema_digest": {
      "type": "string",
      "description": "schema_digest — approved output field for g04.knowledge-schema"
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "valid",
        "invalid"
      ],
      "description": "validation_status — approved output field for g04.knowledge-schema"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "required": [
    "schema_id",
    "normalized_schema",
    "schema_digest",
    "validation_status",
    "evidence"
  ],
  "additionalProperties": false
}
