{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g03.premise-model/output/1.0.0",
  "title": "g03.premise-model output contract v1.0.0",
  "description": "output contract for g03.premise-model: premise statements, source references, confidence values, context",
  "type": "object",
  "properties": {
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "premise_set_digest": {
      "type": "string",
      "minLength": 1
    },
    "normalized_premises": {
      "type": "array",
      "items": {}
    },
    "unresolved_premises": {
      "type": "array",
      "items": {}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "model_id",
    "premise_set_digest",
    "normalized_premises",
    "unresolved_premises",
    "evidence"
  ],
  "additionalProperties": false
}
