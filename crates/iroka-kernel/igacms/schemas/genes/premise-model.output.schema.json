{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g03.premise-model/output/1.0.0",
  "title": "g03.premise-model output contract v1.0.0",
  "description": "output contract for g03.premise-model: premise statements, source references, confidence values, context",
  "type": "object",
  "properties": {
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "premise_set_digest": {
      "type": "string",
      "minLength": 1
    },
    "normalized_premises": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/normalized_premises_item"
      },
      "x-genesis-collection-rules": {
        "uniqueBy": [
          "premise_id"
        ],
        "order": "deterministic normalized output order"
      }
    },
    "unresolved_premises": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolved_premises_item"
      },
      "x-genesis-collection-rules": {
        "uniqueBy": [
          "premise_id"
        ],
        "order": "deterministic"
      }
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "required": [
    "model_id",
    "premise_set_digest",
    "normalized_premises",
    "unresolved_premises",
    "evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    },
    "normalized_premises_item": {
      "type": "object",
      "properties": {
        "premise_id": {
          "type": "string",
          "minLength": 1
        },
        "normalized_statement": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "premise_id",
        "normalized_statement",
        "source_refs",
        "confidence"
      ],
      "additionalProperties": false,
      "$anchor": "g03-premise-model-output-normalized_premises-item-v1-0-0"
    },
    "unresolved_premises_item": {
      "type": "object",
      "properties": {
        "premise_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unresolved_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "premise_id",
        "statement",
        "source_refs",
        "unresolved_reason"
      ],
      "additionalProperties": false,
      "$anchor": "g03-premise-model-output-unresolved_premises-item-v1-0-0"
    }
  }
}
