{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g03.inference-rules/output/1.0.0",
  "title": "g03.inference-rules output contract v1.0.0",
  "description": "output contract for g03.inference-rules: rule set, premise references, inference request, rule version",
  "type": "object",
  "properties": {
    "inference_id": {
      "type": "string",
      "minLength": 1
    },
    "conclusion_set": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conclusion_set_item"
      },
      "x-genesis-collection-rules": {
        "uniqueBy": [
          "conclusion_id"
        ],
        "rule": "all premise/rule references must resolve to supplied inputs"
      }
    },
    "applied_rule_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/applied_rule_ids_item"
      },
      "uniqueItems": true,
      "x-genesis-collection-rules": {
        "rule": "unique IDs; every ID must identify a rule in the input set"
      }
    },
    "unsupported_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unsupported_steps_item"
      },
      "x-genesis-collection-rules": {
        "uniqueBy": [
          "step_id"
        ],
        "rule": "unsupported steps are reported, never silently promoted to conclusions"
      }
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "inference_id",
    "conclusion_set",
    "applied_rule_ids",
    "unsupported_steps",
    "evidence",
    "version_bound_evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    },
    "conclusion_set_item": {
      "type": "object",
      "properties": {
        "conclusion_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "supporting_premise_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "applied_rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "conclusion_id",
        "statement",
        "supporting_premise_ids",
        "applied_rule_ids",
        "confidence"
      ],
      "additionalProperties": false,
      "$anchor": "g03-inference-rules-output-conclusion_set-item-v1-0-0"
    },
    "applied_rule_ids_item": {
      "type": "string",
      "minLength": 1,
      "$anchor": "g03-inference-rules-output-applied_rule_ids-item-v1-0-0"
    },
    "unsupported_steps_item": {
      "type": "object",
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "premise_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "step_id",
        "rule_id",
        "premise_ids",
        "reason"
      ],
      "additionalProperties": false,
      "$anchor": "g03-inference-rules-output-unsupported_steps-item-v1-0-0"
    }
  }
}
