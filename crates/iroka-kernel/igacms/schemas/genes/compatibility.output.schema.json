{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g01.compatibility/output/1.0.0",
  "title": "g01.compatibility output contract v1.0.0",
  "description": "output contract for g01.compatibility: source identity version, target version, compatibility declaration, migration evidence",
  "type": "object",
  "properties": {
    "compatibility": {
      "type": "boolean"
    },
    "decision": {
      "type": "string",
      "enum": [
        "compatible",
        "incompatible",
        "migration_required"
      ]
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "required": [
    "compatibility",
    "decision",
    "policy_id",
    "evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    }
  }
}