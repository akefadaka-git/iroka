{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g02.owner-governance/output/1.0.0",
  "title": "g02.owner-governance output contract v1.0.0",
  "description": "output contract for g02.owner-governance: owner principal, decision request, scope, signed approval, expiry",
  "type": "object",
  "properties": {
    "decision_id": { "type": "string", "minLength": 1 },
    "approval_valid": { "type": "boolean" },
    "authorized_scope": {
      "type": "array",
      "items": { "type": "string", "enum": ["execution:effect:admit","execution:effect:execute","governance:approval:issue","governance:approval:revoke","memory:record:read","memory:record:write","knowledge:source:retrieve","identity:credential:verify"] }
    },
    "decision": { "type": "string", "enum": ["approved","rejected","expired"] },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "required": ["decision_id","approval_valid","authorized_scope","decision","evidence"],
  "additionalProperties": false,
  "$defs": {
    "provenance": { "type": "object", "minProperties": 1 },
    "version_bound_evidence": { "type": "object", "minProperties": 1 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": { "$ref": "#/$defs/provenance" },
        "version_bound_evidence": { "$ref": "#/$defs/version_bound_evidence" }
      },
      "required": ["provenance","version_bound_evidence"]
    }
  }
}