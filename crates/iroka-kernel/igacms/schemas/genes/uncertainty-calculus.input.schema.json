{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g03.uncertainty-calculus/input/1.0.0",
  "title": "g03.uncertainty-calculus input contract v1.0.0",
  "description": "input contract for g03.uncertainty-calculus: hypotheses, evidence weights, calibration profile, calculation method",
  "type": "object",
  "properties": {
    "hypotheses": {
      "type": "array",
      "items": {}
    },
    "evidence_items": {
      "type": "array",
      "items": {}
    },
    "calibration_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "enum": [
        "bayesian",
        "interval",
        "qualitative"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "hypotheses",
    "evidence_items",
    "calibration_id",
    "method",
    "provenance",
    "version_bound_evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    }
  }
}
