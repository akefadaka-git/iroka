{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g08.scheduler-policy/output/1.0.0",
  "title": "Scheduler policy — output",
  "description": "Normative output contract for g08.scheduler-policy v1.0.0, derived from the Owner-approved amendment.",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    },
    "violations_item": {
      "type": "object",
      "properties": {
        "violation_id": {
          "type": "string",
          "minLength": 1
        },
        "class_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "violation_id",
        "class_id",
        "rule_id",
        "expected",
        "observed",
        "severity"
      ],
      "additionalProperties": false,
      "$anchor": "g08-scheduler-policy-output-violations-item-v1-0-0"
    }
  },
  "properties": {
    "policy_id": {
      "type": "string",
      "description": "policy_id — approved output field for g08.scheduler-policy"
    },
    "normalized_policy": {
      "type": "object",
      "properties": {
        "policy_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "priorities": {
          "type": "object",
          "properties": {
            "ordering": {
              "type": "string",
              "enum": [
                "ascending"
              ]
            },
            "lower_number_is_higher": {
              "const": true
            },
            "by_task_class": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "class_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "priority": {
                    "type": "integer"
                  }
                },
                "required": [
                  "class_id",
                  "priority"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "ordering",
            "lower_number_is_higher",
            "by_task_class"
          ],
          "additionalProperties": false
        },
        "quotas": {
          "type": "object",
          "properties": {
            "by_task_class": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "class_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resource": {
                    "type": "string",
                    "enum": [
                      "cpu",
                      "memory",
                      "storage",
                      "execution_time",
                      "concurrency",
                      "token_consumption"
                    ]
                  },
                  "limit": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "window_seconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "burst_limit": {
                    "type": "number",
                    "minimum": 0
                  },
                  "reset_policy": {
                    "type": "string",
                    "enum": [
                      "fixed",
                      "rolling"
                    ]
                  }
                },
                "required": [
                  "class_id",
                  "resource",
                  "limit",
                  "unit",
                  "window_seconds",
                  "burst_limit",
                  "reset_policy"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "by_task_class"
          ],
          "additionalProperties": false
        },
        "deadlines": {
          "type": "object",
          "properties": {
            "by_task_class": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "class_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "deadline_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "expiry_behavior": {
                    "type": "string",
                    "enum": [
                      "reject",
                      "cancel",
                      "deprioritize"
                    ]
                  }
                },
                "required": [
                  "class_id",
                  "deadline_at",
                  "expiry_behavior"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "by_task_class"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "policy_version",
        "priorities",
        "quotas",
        "deadlines"
      ],
      "additionalProperties": false
    },
    "feasibility": {
      "type": "string",
      "enum": [
        "feasible",
        "infeasible",
        "indeterminate"
      ],
      "description": "feasibility — approved output field for g08.scheduler-policy"
    },
    "violations": {
      "type": "array",
      "description": "violations — approved output field for g08.scheduler-policy",
      "items": {
        "$ref": "#/$defs/violations_item"
      },
      "x-genesis-collection-rules": {
        "uniqueBy": [
          "violation_id"
        ],
        "rule": "every referenced class must exist in evaluated policy"
      }
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "required": [
    "policy_id",
    "normalized_policy",
    "feasibility",
    "violations",
    "evidence"
  ],
  "additionalProperties": false
}
