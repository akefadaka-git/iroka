{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g07.agent-principal/output/1.0.0",
  "title": "Agent principal — output",
  "description": "Normative output contract for g07.agent-principal v1.0.0, derived from the Owner-approved amendment.",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    }
  },
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "agent_id — approved output field for g07.agent-principal"
    },
    "principal_valid": {
      "type": "boolean",
      "description": "principal_valid — approved output field for g07.agent-principal"
    },
    "principal_digest": {
      "type": "string",
      "description": "principal_digest — approved output field for g07.agent-principal"
    },
    "identity_status": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "revoked"
      ],
      "description": "identity_status — approved output field for g07.agent-principal"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "version_bound_evidence": {
      "$ref": "#/$defs/version_bound_evidence"
    }
  },
  "required": [
    "agent_id",
    "principal_valid",
    "principal_digest",
    "identity_status",
    "evidence",
    "version_bound_evidence"
  ],
  "additionalProperties": false
}
