{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g01.lineage/output/1.0.0",
  "title": "g01.lineage output contract v1.0.0",
  "description": "output contract for g01.lineage: subject identity, predecessor identity, succession proof, lineage epoch",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "lineage_valid": {
      "type": "boolean"
    },
    "chain_digest": {
      "type": "string",
      "minLength": 1
    },
    "verified_depth": {
      "type": "integer",
      "minimum": 0
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "subject_id",
    "lineage_valid",
    "chain_digest",
    "verified_depth",
    "evidence"
  ],
  "additionalProperties": false
}
