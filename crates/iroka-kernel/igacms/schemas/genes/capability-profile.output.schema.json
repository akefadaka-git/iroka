{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iroka.dev/schemas/genes/g07.capability-profile/output/1.0.0",
  "title": "Capability profile — output",
  "description": "Normative output contract for g07.capability-profile v1.0.0, derived from the Owner-approved amendment.",
  "type": "object",
  "$defs": {
    "provenance": {
      "type": "object",
      "minProperties": 1
    },
    "version_bound_evidence": {
      "type": "object",
      "minProperties": 1
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "version_bound_evidence": {
          "$ref": "#/$defs/version_bound_evidence"
        }
      },
      "required": [
        "provenance",
        "version_bound_evidence"
      ]
    },
    "granted_capabilities_item": {
      "type": "string",
      "minLength": 1,
      "$anchor": "g07-capability-profile-output-granted_capabilities-item-v1-0-0"
    },
    "denied_capabilities_item": {
      "type": "string",
      "minLength": 1,
      "$anchor": "g07-capability-profile-output-denied_capabilities-item-v1-0-0"
    }
  },
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "profile_id — approved output field for g07.capability-profile"
    },
    "granted_capabilities": {
      "type": "array",
      "description": "granted_capabilities — approved output field for g07.capability-profile",
      "items": {
        "$ref": "#/$defs/granted_capabilities_item"
      },
      "uniqueItems": true,
      "x-genesis-collection-rules": {
        "rule": "must be subset of requested capabilities and independently authorized"
      }
    },
    "denied_capabilities": {
      "type": "array",
      "description": "denied_capabilities — approved output field for g07.capability-profile",
      "items": {
        "$ref": "#/$defs/denied_capabilities_item"
      },
      "uniqueItems": true,
      "x-genesis-collection-rules": {
        "rule": "must be subset of requested capabilities; disjoint from granted_capabilities"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "resource": {
                    "type": "string",
                    "enum": [
                      "cpu",
                      "memory",
                      "storage",
                      "execution_time",
                      "concurrency",
                      "token_consumption"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maximum": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "resource",
                  "value",
                  "unit",
                  "maximum"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "limits"
          ],
          "additionalProperties": false
        },
        "policy_imposed": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "resource": {
                    "type": "string",
                    "enum": [
                      "cpu",
                      "memory",
                      "storage",
                      "execution_time",
                      "concurrency",
                      "token_consumption"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maximum": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "resource",
                  "value",
                  "unit",
                  "maximum"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "limits"
          ],
          "additionalProperties": false
        },
        "effective": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "resource": {
                    "type": "string",
                    "enum": [
                      "cpu",
                      "memory",
                      "storage",
                      "execution_time",
                      "concurrency",
                      "token_consumption"
                    ]
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maximum": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "resource",
                  "value",
                  "unit",
                  "maximum"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "limits"
          ],
          "additionalProperties": false
        },
        "enforcement_status": {
          "type": "string",
          "enum": [
            "enforced",
            "partially_enforced",
            "not_enforced"
          ]
        }
      },
      "required": [
        "requested",
        "policy_imposed",
        "effective",
        "enforcement_status"
      ],
      "additionalProperties": false
    },
    "authority_granted": {
      "type": "boolean",
      "description": "authority_granted — approved output field for g07.capability-profile"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "required": [
    "profile_id",
    "granted_capabilities",
    "denied_capabilities",
    "limits",
    "authority_granted",
    "evidence"
  ],
  "additionalProperties": false
}
